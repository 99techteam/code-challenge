# Copy this file to .env and adjust the values for your environment.

# HTTP server port.
PORT=3000

# PGlite data directory. Use memory:// for a temporary in-memory database.
PGLITE_DATA_DIR=data/pglite

# Optional local PostgreSQL-compatible socket for TablePlus or psql.
# Uncomment to enable it.
# PGLITE_SOCKET_PORT=5544
