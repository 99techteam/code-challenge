{
    "name": "problem5-resource-service",
    "version": "1.0.0",
    "description": "ExpressJS + TypeScript CRUD service for resources",
    "private": true,
    "type": "module",
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "node --watch --loader ts-node/esm src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/server.js",
        "test:e2e": "node --loader ts-node/esm --test test/e2e/**/*.test.ts"
    },
    "engines": {
        "node": ">=22.5.0"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "reflect-metadata": "^0.2.2",
        "sqlite3": "^5.1.7",
        "typeorm": "^0.3.24"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.4",
        "@types/supertest": "^6.0.3",
        "supertest": "^7.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.2"
    }
}
